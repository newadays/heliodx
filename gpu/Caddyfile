# Single port for Cloud Run. /v1/* is Muse Glimmer (vLLM, OpenAI-compatible);
# everything else is the SAM server (/sam/segment, /health).
{
	admin off
	auto_https off
}

:8080 {
	handle /v1/* {
		reverse_proxy 127.0.0.1:8001 {
			flush_interval -1
			transport http {
				read_timeout 600s
			}
		}
	}
	handle {
		reverse_proxy 127.0.0.1:8002 {
			transport http {
				read_timeout 120s
			}
		}
	}
}
