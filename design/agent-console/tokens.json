{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "name": "HelioDX tokens",
  "version": "1.1.0",
  "palette": "black and white; green = success only; red = failure/attention only",
  "app": {
    "color": {
      "ground": "#F4F6F8",
      "surface": "#FFFFFF",
      "surface2": "#FAFBFC",
      "surfaceTint": "#F4F6F8",
      "previewGround": "#E9EDF1",
      "ink": "#15181C",
      "ink2": "#3D444D",
      "muted": "#5F6873",
      "line": "#E1E5EA",
      "lineStrong": "#C9CFD6",
      "primary": "#15181C",
      "primaryHover": "#000000",
      "primaryDisabled": "#9AA0A6",
      "focusRing": "rgba(21,24,28,0.14)",
      "green": "#137A3A",
      "greenTint": "#E6F4EA",
      "greenLine": "#BFE3CB",
      "greenTint2": "#F0FAF3",
      "greenBright": "#3DDC84",
      "greenPulse": "#16A34A",
      "red": "#B42318",
      "redTint": "#FDECEA",
      "redLine": "#F3B9B3",
      "redBright": "#FF6B6B",
      "chipNeutralBg": "#EDF0F3",
      "chipNeutralInk": "#3D444D",
      "viewerBg": "#0C1014",
      "viewerLine": "#1C2229",
      "viewerText": "#C8D0D8",
      "viewerMuted": "#8B96A3",
      "viewerChrome": "#1A2027",
      "viewerBorder": "#2A323B",
      "viewerLabel": "#DFF7E8",
      "viewerDim": "rgba(12,16,20,0.35)",
      "viewerDimStrong": "rgba(12,16,20,0.45)"
    },
    "semantics": {
      "primaryAction": "primary",
      "currentStep": "primary",
      "selection": "primary",
      "progress": "primary",
      "success": "green",
      "accepted": "green",
      "doneStep": "green",
      "ready": "green",
      "live": "greenPulse",
      "signedStrip": "greenTint",
      "markerNormal": "green",
      "measurementOverlay": "greenBright",
      "failure": "red",
      "needsAttention": "red",
      "reject": "red",
      "flaggedRegion": "redBright",
      "environmentChip": "outline ink on white"
    },
    "font": {
      "sans": "'IBM Plex Sans', system-ui, -apple-system, 'Segoe UI', sans-serif",
      "mono": "'IBM Plex Mono', ui-monospace, SFMono-Regular, Menlo, monospace",
      "googleFontsHref": "https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@500;600&display=swap"
    },
    "fontSize": { "xs": 11.5, "sm": 12.5, "base": 14, "md": 15, "lg": 16, "xl": 18, "2xl": 22, "3xl": 26, "4xl": 28 },
    "lineHeight": { "ui": 1.45, "prose": 1.5 },
    "letterSpacing": { "label": "0.06em", "tight": "-0.01em", "tighter": "-0.015em" },
    "space": { "1": 4, "2": 8, "3": 12, "4": 16, "5": 20, "6": 24, "7": 28, "8": 32, "10": 40 },
    "radius": { "sm": 6, "base": 8, "lg": 12, "xl": 14, "pill": 999 },
    "size": {
      "target": 44, "targetSm": 36, "headerH": 56, "viewerW": 620, "panelMin": 560,
      "consoleW": 480, "uploadW": 520, "casesW": 320, "pageMax": 1240, "marker": 28, "markerFocus": 34, "numChip": 24,
      "wrapBreakpoint": 1180
    },
    "shadow": {
      "marker": "0 1px 5px rgba(0,0,0,0.6)",
      "note": "0 8px 24px rgba(21,24,28,0.06)",
      "chip": "0 8px 24px rgba(0,0,0,0.5)"
    },
    "motion": {
      "pulse": "1.2s ease-in-out infinite",
      "shimmer": "1.4s linear infinite",
      "scan": "3.4s ease-in-out infinite alternate"
    },
    "confidenceBands": { "high": 0.85, "moderate": 0.6 },
    "upload": { "maxFileMB": 50, "accept": [".dcm", ".dicom", "image/jpeg", "image/png"] }
  },
  "landing": {
    "color": {
      "bg": "#0A0C10",
      "surface": "#10141A",
      "line": "#1E242C",
      "lineSoft": "#161B22",
      "text": "#FFFFFF",
      "text2": "#E6EBE7",
      "body": "#B5BDB7",
      "muted": "#8A939A",
      "nav": "#C2CAC5",
      "accent": "#7FEE64",
      "accentHover": "#A6F58F",
      "accentGlow": "rgba(127,238,100,0.12)",
      "accentRing": "rgba(127,238,100,0.45)",
      "pillLight": "#F2F5F3",
      "pillDark": "#14181F",
      "pillDarkHover": "#1B2129",
      "pillLine": "#2A313B",
      "badge": "#FFFFFF"
    },
    "fontSize": { "h1": "clamp(38px, 4.6vw, 62px)", "h2": 30, "footerTitle": 28, "body": 17 }
  }
}
