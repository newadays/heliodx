{
  "name": "heliodx-functions",
  "license": "AGPL-3.0-or-later",
  "version": "0.1.0",
  "private": true,
  "description": "HelioDX Cloud Functions: study AI pipeline, organization binding, sharing",
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:watch": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.tools.json --noEmit",
    "serve": "npm run build && firebase emulators:start",
    "test": "vitest run --exclude test/rules",
    "test:rules": "firebase emulators:exec --only auth,firestore,storage \"vitest run test/rules --no-file-parallelism\"",
    "seed": "tsx scripts/seed.ts",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "invite": "tsx scripts/invite.ts",
    "demo-user": "tsx scripts/demo-user.ts",
    "eval": "tsx scripts/eval.ts"
  },
  "dependencies": {
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0",
    "google-auth-library": "^10.9.1",
    "pdfkit": "^0.17.2",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@types/node": "^22.0.0",
    "@types/pdfkit": "^0.17.3",
    "firebase": "^13.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vitest": "^5.0.5"
  }
}
