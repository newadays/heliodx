*service-account*.json
*-sa-key*.json

# Python
__pycache__/
*.pyc

# GPU service settings (project, region, bucket); template: gpu/env.example.sh
gpu/env.sh

# One-off live test scripts
functions/.e2e-*.ts

#misc
.vscode/

# Demo sample images and manifest (data/fetch_demo_samples.py)
data/out/