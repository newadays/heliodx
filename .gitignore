# dependencies
node_modules/

# build output
dist/
*.tsbuildinfo
functions/lib/

# macOS
.DS_Store

# keys and certificates
*.pem
*.key
*.p12

# local env files (EXPO_PUBLIC_* values for the web build; never server secrets)
.env
.env*.local
.env.dev
.env.development
.env.production
# Functions emulator secret overrides (e.g. META_API_KEY)
.secret.local
functions/.env*

# logs
npm-debug.*
firebase-debug.log
*-debug.log
.firebase/

