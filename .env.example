# Copy to .env.development (and .env.production for release builds), then
# fill in the Web app config from your Firebase project settings.
# These files are gitignored. EXPO_PUBLIC_* values are bundled into the web
# app (the prefix is historical), so never put a server secret here.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-firebase-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-firebase-project
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-firebase-project.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=
# 1 = use the local Firebase emulators instead of the cloud project
EXPO_PUBLIC_USE_EMULATORS=0
