# Copy to .env.development (and .env.production for release builds), then
# fill in the Web app config from your Firebase project settings.
# These files are gitignored. VITE_* values are bundled into the web
# app (the prefix is historical), so never put a server secret here.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-firebase-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-firebase-project
VITE_FIREBASE_STORAGE_BUCKET=your-firebase-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
# 1 = use the local Firebase emulators instead of the cloud project
VITE_USE_EMULATORS=0
